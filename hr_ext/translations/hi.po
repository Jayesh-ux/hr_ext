msgid "Sure {name}, I've applied for your leave from {from_date} to {to_date}."
msgstr "ठीक है {name}, मैंने आपकी छुट्टी {from_date} से {to_date} तक के लिए लागू कर दी है।"

msgid "Your available {leave_type} balance is {balance} days."
msgstr "आपकी उपलब्ध {leave_type} छुट्टी का बैलेंस {balance} दिन है।"

msgid "Your attendance for today is: {status}."
msgstr "आज के लिए आपकी उपस्थिति: {status}।"

msgid "Expense claim request received for {amount} ({currency}). Draft created as {name}."
msgstr "व्यय दावा आवेदन {amount} ({currency}) के लिए प्राप्त हुआ। ड्राफ्ट {name} के रूप में बनाया गया।"

msgid "Your estimated take-home for a monthly gross of {gross} ({currency}) is {net} ({currency}) in {country}, assuming standard deductions."
msgstr "आपकी अनुमानित शुद्ध आय मासिक ग्रॉस {gross} ({currency}) पर {net} ({currency}) है ({country} में), मानक कटौती मानते हुए।"

msgid "I can help with leave, attendance, expense claims and salary estimates. Try 'I need leave tomorrow'."
msgstr "मैं छुट्टी, उपस्थिति, व्यय दावों और वेतन अनुमानों में मदद कर सकता हूँ। 'I need leave tomorrow' आज़माएँ।"

msgid "I couldn't find an employee record linked to your user. Please contact HR."
msgstr "आपके उपयोगकर्ता से जुड़ा कोई कर्मचारी रिकॉर्ड नहीं मिला। कृपया HR से संपर्क करें।"

msgid "I understood you, but I'm missing details. Could you clarify your request?"
msgstr "मैं समझ गया, लेकिन कुछ विवरण गायब हैं। क्या आप अपना अनुरोध स्पष्ट कर सकते हैं?"

msgid "Attrition Risk Score"
msgstr "एट्रिशन जोखिम स्कोर"

msgid "Risk Score (0..1)"
msgstr "जोखिम स्कोर (0..1)"

msgid "Risk Level"
msgstr "जोखिम स्तर"

msgid "Nudge Log"
msgstr "अनुस्मारक लॉग"