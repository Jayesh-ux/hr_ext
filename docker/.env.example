# Copy to docker/.env and fill in. NEVER commit docker/.env.
# The Administrator password is supplied here (or via Docker secrets) and is
# never copied into the image or apps.json.

SITE_NAME=hr.localhost
DB_ROOT_PASSWORD=change-me-root
DB_HOST=mariadb
DB_PORT=3306

# Administrator password for the new site (also used to rotate any existing one)
ADMIN_PASSWORD=change-me-admin

# Pin the built image and base image tags for reproducibility
HR_EXT_IMAGE=hr_ext:v15
ERPNEXT_TAG=version-15
HR_EXT_NGINX_IMAGE=frappe/erpnext-nginx:version-15

HTTP_PORT=8080

# Nudges
HR_EXT_DEFAULT_COUNTRY=india
# Real HR user (email/username) that nudges route to instead of Administrator
HR_EXT_NUDGE_HR_USER=
# Delivery channel: leave blank to keep the sandbox mock; set to "email" on host
HR_EXT_NUDGE_CHANNEL=
# Send nudge email synchronously (handy for the one-shot delivery test)
HR_EXT_EMAIL_NOW=
